stateDiagram-v2
    state "● Accepted" as Accepted
    state "✓ Executed" as Executed
    state "× Failed" as Failed
    state "? Outcome unknown" as Unknown
    [*] --> Accepted
    Accepted --> Executed: execution evidence
    Accepted --> Failed: failure evidence
    Accepted --> Unknown: timeout
    Unknown --> Executed: reconciled success
    Unknown --> Failed: reconciled failure
